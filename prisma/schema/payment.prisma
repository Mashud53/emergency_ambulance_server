model Payment{
    id String @id @default(uuid())
    amount Decimal @db.Decimal(10,2)
    status PaymentStatus @default(UNPAID)
    currency String @default("BDT")

    paymentGateway String @default("bkash")
    merchantInvoiceNumber String @unique

    bkashPaymnetId String?
    bkshTrxId String?
    payerReferench String?
    paidAt String?

    gateWayResponse Json?

    emergencyId String @unique
    emergency Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("payments")
    
}