```ejs
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Changed Successfully</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f4f6f8;
    font-family: Arial, Helvetica, sans-serif;
">

    <table width="100%" cellpadding="0" cellspacing="0" border="0"
        style="background-color: #f4f6f8; padding: 40px 15px;">

        <tr>
            <td align="center">

                <!-- Main Card -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0"
                    style="
                        max-width: 520px;
                        background-color: #ffffff;
                        border-radius: 12px;
                        overflow: hidden;
                    ">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="padding: 35px 30px 20px;">

                            <!-- Success Icon -->
                            <div style="
                                width: 60px;
                                height: 60px;
                                line-height: 60px;
                                background-color: #dcfce7;
                                border-radius: 50%;
                                color: #16a34a;
                                font-size: 30px;
                                font-weight: bold;
                                margin-bottom: 18px;
                            ">
                                ✓
                            </div>

                            <h1 style="
                                margin: 0;
                                color: #111827;
                                font-size: 25px;
                                font-weight: 700;
                            ">
                                Password Changed Successfully
                            </h1>

                            <p style="
                                margin: 10px 0 0;
                                color: #6b7280;
                                font-size: 14px;
                            ">
                                Your account password has been updated
                            </p>

                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 15px 35px 35px;">

                            <p style="
                                margin: 0 0 15px;
                                color: #374151;
                                font-size: 16px;
                                line-height: 1.6;
                            ">
                                Hello <strong><%= name %></strong>,
                            </p>

                            <p style="
                                margin: 0 0 20px;
                                color: #4b5563;
                                font-size: 15px;
                                line-height: 1.7;
                            ">
                                This is a confirmation that the password for your
                                <strong>Emergency Ambulance Service</strong> account was successfully
                                changed.
                            </p>

                            <!-- Account Information -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0"
                                style="
                                    background-color: #f9fafb;
                                    border-radius: 8px;
                                    margin: 20px 0;
                                ">

                                <tr>
                                    <td style="
                                        padding: 18px;
                                        color: #374151;
                                        font-size: 14px;
                                    ">

                                        <p style="margin: 0 0 10px;">
                                            <strong>Account:</strong>
                                            <%= email %>
                                        </p>

                                        <p style="margin: 0;">
                                            <strong>Changed at:</strong>
                                            <%= changedAt %>
                                        </p>

                                    </td>
                                </tr>

                            </table>

                            <p style="
                                margin: 20px 0;
                                color: #4b5563;
                                font-size: 15px;
                                line-height: 1.7;
                            ">
                                You can now use your new password to sign in to your
                                account.
                            </p>

                            <!-- Login Button -->
                            

                            <!-- Security Warning -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0"
                                style="margin-top: 28px;">

                                <tr>
                                    <td style="
                                        background-color: #fef2f2;
                                        border-left: 4px solid #dc2626;
                                        padding: 14px 15px;
                                    ">

                                        <p style="
                                            margin: 0;
                                            color: #991b1b;
                                            font-size: 13px;
                                            line-height: 1.6;
                                        ">
                                            <strong>Didn't change your password?</strong><br>
                                            Your account may be at risk. Please contact our
                                            support team immediately and secure your account.
                                        </p>

                                    </td>
                                </tr>

                            </table>

                            <p style="
                                margin: 25px 0 0;
                                color: #6b7280;
                                font-size: 13px;
                                line-height: 1.6;
                            ">
                                For your security, never share your password with anyone.
                                Our team will never ask you for your password.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center"
                            style="
                                background-color: #f9fafb;
                                padding: 22px 30px;
                            ">

                            <p style="
                                margin: 0 0 8px;
                                color: #6b7280;
                                font-size: 13px;
                            ">
                                Need help? Contact our support team.
                            </p>

                           
                        </td>
                    </tr>

                </table>

            </td>
        </tr>

    </table>

</body>

</html>
```
